# ============================================================
#  IBM watsonx.ai / Granite Configuration
# ============================================================

# IBM Cloud API Key — create at https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=your_ibm_cloud_api_key_here

# watsonx.ai Project ID — found in your watsonx.ai project settings
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# watsonx.ai API base URL (update region if needed: us-south, eu-de, etc.)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model ID to use
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ============================================================
#  Server Configuration
# ============================================================
PORT=3000
NODE_ENV=development

# Allowed CORS origin (set to your frontend URL in production)
CORS_ORIGIN=http://localhost:5500
